# Copy to .env and fill in what you need. Nothing here is required to run
# Kronagent in dry-run with sample data — every credential below degrades
# gracefully if omitted (see kronagent/config.py and kronagent/llm.py).

# LLM-enriched triage, threat-intel, correlation, and incident commander.
# Omit this and the pipeline falls back to deterministic triage only.
GEMINI_API_KEY=

# AWS — only needed for live SQS ingestion or real containment execution.
# AWS_REGION=us-east-1

# Kubernetes — only needed for real containment execution against a cluster.
# KRONAGENT_KUBECONFIG=/path/to/kubeconfig
# KRONAGENT_KUBE_CONTEXT=

# See README.md "Going live against real infrastructure" for the full list
# of safety-critical settings (KRONAGENT_DRY_RUN, KRONAGENT_KILL_SWITCH, etc.).
