{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kronagent Active Containment Cross-Account IAM Role for Automated Remediation",
  "Parameters": {
    "KronagentAccountId": {
      "Type": "String",
      "Description": "AWS Account ID of the Kronagent platform (e.g. 123456789012)",
      "AllowedPattern": "^\\d{12}$"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "Unique secret External ID provided by Kronagent for your tenant",
      "MinLength": 16,
      "MaxLength": 1224
    },
    "QuarantineSecurityGroupId": {
      "Type": "String",
      "Description": "ID of your pre-provisioned deny-all Security Group for EC2 isolation (e.g. sg-0123456789abcdef0)"
    },
    "QuarantineNaclId": {
      "Type": "String",
      "Default": "",
      "Description": "Optional ID of your pre-provisioned Network ACL for IP blocking (e.g. acl-0123456789abcdef0)"
    },
    "RoleName": {
      "Type": "String",
      "Default": "KronagentContainRole",
      "Description": "Name of the IAM role to create"
    }
  },
  "Resources": {
    "KronagentContainRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Ref": "RoleName" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": { "Fn::Sub": "arn:aws:iam::${KronagentAccountId}:root" }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": { "Ref": "ExternalId" }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KronagentContainPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DisableAndReenableAccessKeys",
                  "Effect": "Allow",
                  "Action": "iam:UpdateAccessKey",
                  "Resource": { "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:user/*" }
                },
                {
                  "Sid": "QuarantineDenyAllInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": ["iam:PutUserPolicy", "iam:DeleteUserPolicy"],
                  "Resource": { "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:user/*" },
                  "Condition": {
                    "StringEquals": { "iam:PolicyName": "kronagent-quarantine-deny-all" }
                  }
                },
                {
                  "Sid": "RevokeRoleSessionsInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": ["iam:PutRolePolicy", "iam:DeleteRolePolicy"],
                  "Resource": { "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/*" },
                  "Condition": {
                    "StringEquals": { "iam:PolicyName": "kronagent-revoke-sessions-deny-all" }
                  }
                },
                {
                  "Sid": "IsolateEc2InstanceSecurityGroup",
                  "Effect": "Allow",
                  "Action": "ec2:ModifyInstanceAttribute",
                  "Resource": { "Fn::Sub": "arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:instance/*" }
                },
                {
                  "Sid": "BlockIpNaclEntry",
                  "Effect": "Allow",
                  "Action": ["ec2:CreateNetworkAclEntry", "ec2:ReplaceNetworkAclEntry", "ec2:DeleteNetworkAclEntry"],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "ARN of the created Kronagent Contain IAM Role. Copy this back to Kronagent console.",
      "Value": { "Fn::GetAtt": ["KronagentContainRole", "Arn"] }
    }
  }
}
